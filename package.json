{
  "name": "sports-video-player",
  "version": "0.1.1",
  "description": "ジェスチャー操作型 動画プレーヤー（Webコンポーネント <sports-video-player>）",
  "type": "module",
  "main": "./dist/sports-video-player.iife.js",
  "module": "./dist/sports-video-player.js",
  "exports": {
    ".": {
      "import": "./dist/sports-video-player.js",
      "default": "./dist/sports-video-player.iife.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --host",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
